# =============================================================================
# Viche Contracts — Deployment environment variables
# =============================================================================

# RPC URL (e.g. http://127.0.0.1:8545 for local Anvil, or https://sepolia.infura.io/v3/...)
RPC_URL=http://127.0.0.1:8545

# Private Key for contract deployment (0x-prefixed hex string)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Etherscan / Sepolia Explorer API key for verification
ETHERSCAN_API_KEY=

# (Optional) Pre-deployed Groth16 Verifier contract address
VERIFIER_ADDRESS=

# --- Verification-key guard (REQUIRED to deploy) ------------------------------
# keccak256 of the deployed Groth16Verifier's runtime bytecode. The deploy
# script refuses to run unless this matches the verifier it is about to wire
# into VotingManager, because `VotingManager.verifier` is immutable and a
# verifier from a trusted setup whose toxic waste still exists lets its holder
# forge unlimited votes.
#
# To obtain the value: run the deploy against a scratch network with
# ALLOW_DEV_VERIFIER=true and copy the "Verifier codehash" it prints, or
# compute it locally -- see docs/trusted-setup-ceremony.md ("Recording the
# verification-key hash"). Record it alongside the ceremony transcript, not
# only here.
VKEY_HASH=

# Escape hatch for LOCAL / ANVIL DEVELOPMENT ONLY. Skips the check above
# entirely. Leave unset (or false) for anything else; scripts/dev.ps1 sets it
# itself for its throwaway anvil.
ALLOW_DEV_VERIFIER=
