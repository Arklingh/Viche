# viche-relayer local env (Phase 2). Copy to .env and fill in.
# Filled values are for the local anvil default account.
#
# =============================================================================
# This file lists only the REQUIRED settings — the five the relayer refuses to
# start without, plus the listen address.
#
# Everything else (rate limits, body caps, request timeout, concurrency
# ceiling, CORS, proxy trust, gas-price ceiling, readiness balance thresholds,
# and the whole voter-registration Sybil gate) is OPTIONAL and defaults to the
# restrictive option — you opt *out* of safety, never into it. The full
# annotated list, with every default and the reasoning behind it, lives in the
# repo-root `.env.example`. It is deliberately not duplicated here: two copies
# of ~25 settings drift, and the drift is silent.
#
# Read that file before any deployment that is not local anvil. Two settings
# in particular will not do what you want out of the box:
#
#   REGISTRATION_ELIGIBILITY   code default is `invite-code`, and the relayer
#                              REFUSES TO START if you select it without
#                              configuring any codes. The repo-root example
#                              sets `open` so `scripts/dev.ps1` works — `open`
#                              is Sybil-farmable and is dev-only.
#   CORS_ALLOWED_ORIGINS       defaults to empty (no cross-origin access).
#                              Correct when the SPA and API share one origin
#                              behind a reverse proxy, which is the expected
#                              production topology.
# =============================================================================

RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Signs createPoll / closePoll / cancelPoll / voidPoll (POST /api/admin/*) —
# must be the deployed VotingManager's owner. Using anvil account #0 here too
# is only correct because that's also the local deploy account (== initial
# owner); in any real deployment this MUST be a different key from
# RELAYER_PRIVATE_KEY. The relayer's gas wallet sits on an internet-facing
# host signing unauthenticated requests; the admin key can void a live poll.
ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Shared secret required as `Authorization: Bearer <key>` on /api/admin/*.
# Generate a real one for anything beyond local dev, e.g.: openssl rand -hex 32
ADMIN_API_KEY=dev-only-change-me

RPC_URL=http://127.0.0.1:8545
VOTING_MANAGER_ADDRESS=
VERIFIER_ADDRESS=
RELAYER_LISTEN_ADDR=0.0.0.0
RELAYER_LISTEN_PORT=3000
