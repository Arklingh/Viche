# viche-relayer local env (Phase 2). Copy to .env and fill in.
# Filled values are for the local anvil default account.

RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Signs createPoll/closePoll (POST /api/admin/*) — must be the deployed
# VotingManager's owner. Using anvil account #0 here too is only correct
# because that's also the local deploy account (== initial owner); in any
# real deployment this MUST be a different key from RELAYER_PRIVATE_KEY.
ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Shared secret required as `Authorization: Bearer <key>` on /api/admin/*.
# Generate a real one for anything beyond local dev, e.g.: openssl rand -hex 32
ADMIN_API_KEY=dev-only-change-me

RPC_URL=http://127.0.0.1:8545
VOTING_MANAGER_ADDRESS=
VERIFIER_ADDRESS=
RELAYER_LISTEN_ADDR=0.0.0.0
RELAYER_LISTEN_PORT=3000
