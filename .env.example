# =============================================================================
# Viche — example environment variables.
#
# Copy to `.env` and fill in real values. `.env` itself is gitignored.
# =============================================================================

# --- Deployment / Ethereum private key ---------------------------------------
# Deployer EOA private key (hex string with 0x prefix)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Relayer signer (Phase 2) -------------------------------------------------
# A funded EOA that the relayer uses to pay gas for `castVote` transactions.
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Ethereum RPC endpoint ----------------------------------------------------
# JSON-RPC URL (anvil on :8545 for local dev, Sepolia/Mainnet RPC for testnet)
RPC_URL=http://127.0.0.1:8545

# --- Block explorer verification ----------------------------------------------
# Etherscan / Sepolia explorer API key for contract verification (--verify)
ETHERSCAN_API_KEY=

# --- Deployed contract addresses ---------------------------------------------
# Filled in after running `forge script script/DeployVotingManager.s.sol`.
VOTING_MANAGER_ADDRESS=
VERIFIER_ADDRESS=

# --- HTTP server (relayer, Phase 2) ------------------------------------------
RELAYER_LISTEN_ADDR=0.0.0.0
RELAYER_LISTEN_PORT=3000

# =============================================================================
# Relayer hardening
#
# Every variable below is OPTIONAL. The value shown after "default:" is what
# the relayer uses when the variable is absent, and in every case that default
# is the restrictive option — you opt *out* of safety, never into it.
#
# The one exception worth reading twice is REGISTRATION_ELIGIBILITY: its code
# default is `invite-code`, and the relayer REFUSES TO START if you select it
# without configuring any codes. This file sets `open` instead, because the
# local dev loop (`scripts/dev.ps1`) needs registration to work with no extra
# setup. `open` is Sybil-farmable. Change it before you deploy anything real.
# =============================================================================

# --- Expected production topology --------------------------------------------
#
#   browser ──TLS──> reverse proxy ──HTTP──> viche-relayer :3000
#                     │  /                    SPA (Trunk build)
#                     └─ /api, /health, /ready  -> relayer
#
# The SPA and the API are served from ONE origin, so nothing needs CORS. That
# is why CORS_ALLOWED_ORIGINS defaults to empty rather than `*`.

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of exact origins allowed to call the API cross-origin.
# default: (empty) — no cross-origin access at all.
# `*` is rejected at boot: these endpoints spend the relayer's ETH.
# Example: CORS_ALLOWED_ORIGINS=https://vote.example.org,https://www.example.org
CORS_ALLOWED_ORIGINS=

# --- Client IP / proxy trust ---------------------------------------------------
# Whether to believe X-Forwarded-For / X-Real-IP when attributing a request to
# an IP for rate limiting.  default: false
#
# Leave this false when the relayer is directly exposed: with it on, anyone can
# forge a fresh IP per request and defeat the rate limiter entirely.
# Turn it on ONLY behind a proxy you control that strips and rewrites those
# headers — otherwise every request looks like it came from the proxy and the
# whole internet shares one rate-limit bucket.
TRUST_PROXY_HEADERS=false
# How many proxies you control sit in front of this process. Only the trailing
# `hops` entries of the forwarded chain are skipped. default: 1
TRUSTED_PROXY_HOPS=1

# --- Rate limits (per client IP, token bucket) ---------------------------------
# `PER_MINUTE` is the sustained refill rate; `BURST` is the bucket size, i.e.
# how many requests may arrive back-to-back before the sustained rate bites.
#
# POST /api/vote — spends the relayer's ETH.        defaults: 5 / 5
RATE_LIMIT_VOTE_PER_MINUTE=5
RATE_LIMIT_VOTE_BURST=5
# POST /api/register — grows persistent state.      defaults: 3 / 3
RATE_LIMIT_REGISTER_PER_MINUTE=3
RATE_LIMIT_REGISTER_BURST=3
# Read-only poll/tally/readiness endpoints.         defaults: 120 / 60
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_READ_BURST=60
# /api/admin/* — also throttles API-key guessing.   defaults: 60 / 30
RATE_LIMIT_ADMIN_PER_MINUTE=60
RATE_LIMIT_ADMIN_BURST=30
# Cap on distinct IPs each limiter tracks, so an IPv6-rotation flood can't grow
# the bucket map without bound. default: 100000
RATE_LIMIT_MAX_TRACKED_IPS=100000

# --- Request body size caps (bytes) --------------------------------------------
# A well-formed vote is a 256-byte proof plus three small scalars — under 800
# bytes of JSON. Axum's 2 MB default is ~2500x larger than anything legitimate.
MAX_VOTE_BODY_BYTES=4096        # default: 4096
MAX_REGISTER_BODY_BYTES=1024    # default: 1024
MAX_ADMIN_BODY_BYTES=1048576    # default: 1048576 (an approval list can be big)
MAX_BODY_BYTES=16384            # default: 16384 (everything else)

# --- Timeouts and load shedding -------------------------------------------------
# Whole-request deadline in seconds. A hung RPC backend becomes a 504 instead of
# an in-flight request that never finishes. default: 20
REQUEST_TIMEOUT_SECS=20
# Maximum simultaneously in-flight requests. Past this the relayer sheds with
# 503 rather than queueing unbounded work behind a slow backend. default: 64
MAX_CONCURRENT_REQUESTS=64

# --- Gas price ceiling -----------------------------------------------------------
# Hard cap on maxFeePerGas, in gwei. A transaction estimated above this is
# REJECTED with a clear error rather than broadcast, so a gas spike can't drain
# the relayer wallet unattended. default: 150
MAX_FEE_PER_GAS_GWEI=150

# --- Readiness thresholds (GET /ready) -------------------------------------------
# GET /health is liveness only (is the process up?) and never touches the chain.
# GET /ready checks that the RPC answers AND that the relayer wallet can still
# pay for votes.
#
# Below this balance (wei), /ready returns 503 so a load balancer drains the
# instance. default: 10000000000000000 (0.01 ETH — roughly 200 votes at the
# 150 gwei ceiling and ~300k gas each)
RELAYER_MIN_BALANCE_WEI=10000000000000000
# Below this (but above the minimum), /ready returns 200 with status
# "degraded" — so monitoring pages you while the relayer still works, rather
# than only once it has already stopped. default: 50000000000000000 (0.05 ETH)
RELAYER_LOW_BALANCE_WEI=50000000000000000

# =============================================================================
# Voter registration — Sybil resistance
#
# POST /api/register is NOT safe to leave open. A commitment is a one-way hash,
# so submitting one reveals nothing about you — but that cuts both ways: an
# attacker who submits 10,000 distinct commitments is indistinguishable from
# 10,000 voters, and owns the entire electorate if that batch is ever
# snapshotted and published.
#
# Four independent mechanisms guard it. You supply the policy; the relayer
# supplies the mechanism.
# =============================================================================

# --- 1. Eligibility gate -----------------------------------------------------
# One of: invite-code | allowlist | open      code default: invite-code
#
#   invite-code  Request must carry `X-Invite-Code: <code>` matching a code
#                below that still has uses left. Boot FAILS if no codes are set.
#   allowlist    The submitted commitment must appear in the allowlist file.
#                Boot FAILS if no file is set.
#   open         Anyone may register. Sybil-farmable — dev only, or for a
#                community that reviews every batch by hand.
#
# Set to `open` here purely so `scripts/dev.ps1` works out of the box.
# >>> CHANGE THIS FOR ANY REAL DEPLOYMENT. <<<
REGISTRATION_ELIGIBILITY=open

# Comma-separated `code` or `code:max_uses` entries. A bare code has unlimited
# uses; a cap makes an invite a spendable budget, so a leaked code costs at most
# its cap rather than the whole electorate. default: (empty)
# Example: REGISTRATION_INVITE_CODES=spring-2026:250,board-members:12,press
REGISTRATION_INVITE_CODES=

# Path to a newline-separated file of eligible commitments (decimal or 0x-hex;
# `#` comments and blank lines ignored). default: (empty)
REGISTRATION_ALLOWLIST_FILE=

# Need something else — a token balance, an SSO group, an attestation? Implement
# the `EligibilityPolicy` trait and swap it in at construction; you do not need
# to fork the crate. See crates/viche-relayer/src/eligibility.rs.

# --- 2. Admin review / approval ------------------------------------------------
# When true, a pending commitment does NOT flow into a snapshot until an admin
# approves it. default: true
#
# Review flow:
#   GET  /api/admin/registrations/pending?detailed=true   provenance + the
#        `source_clusters` summary (one source accounting for 400 of 420
#        registrations is what you are looking for)
#   POST /api/admin/registrations/approve  {"commitments":[...]} or {"all":true}
#   POST /api/admin/registrations/reject   {"commitments":[...]}
#   POST /api/admin/registrations/snapshot takes only the approved entries
#
# Setting this to false restores the old behaviour (everything auto-approved).
# That is at least visible in your configuration, which "always click approve"
# is not.
REGISTRATION_REQUIRE_APPROVAL=true

# --- 3. Caps ---------------------------------------------------------------------
# Max pending registrations attributable to one network source. The source is
# stored only as a salted keccak hash — never a raw IP. default: 5
REGISTRATION_MAX_PER_SOURCE=5
# Max total pending registrations in one batch. default: 10000
REGISTRATION_MAX_PENDING=10000

# --- 4. Rate limiting ------------------------------------------------------------
# See RATE_LIMIT_REGISTER_* above.

# --- Storage ----------------------------------------------------------------------
# Path to the registration store's JSON file. Written atomically (temp file +
# rename); a file that exists but does not parse is backed up to
# `<path>.corrupt.<timestamp>` and the relayer REFUSES TO START, rather than
# silently wiping the registry. default: registrations.json
REGISTRATIONS_FILE=registrations.json
