# =============================================================================
# Viche — example environment variables.
#
# Copy to `.env` and fill in real values. `.env` itself is gitignored.
# =============================================================================

# --- Deployment / Ethereum private key ---------------------------------------
# Deployer EOA private key (hex string with 0x prefix)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Relayer signer (Phase 2) -------------------------------------------------
# A funded EOA that the relayer uses to pay gas for `castVote` transactions.
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Ethereum RPC endpoint ----------------------------------------------------
# JSON-RPC URL (anvil on :8545 for local dev, Sepolia/Mainnet RPC for testnet)
RPC_URL=http://127.0.0.1:8545

# --- Block explorer verification ----------------------------------------------
# Etherscan / Sepolia explorer API key for contract verification (--verify)
ETHERSCAN_API_KEY=

# --- Deployed contract addresses ---------------------------------------------
# Filled in after running `forge script script/DeployVotingManager.s.sol`.
VOTING_MANAGER_ADDRESS=
VERIFIER_ADDRESS=

# --- HTTP server (relayer, Phase 2) ------------------------------------------
RELAYER_LISTEN_ADDR=0.0.0.0
RELAYER_LISTEN_PORT=3000
